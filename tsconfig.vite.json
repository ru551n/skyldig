{
  "extends": "./tsconfig.json",
  "include": [
    ".react-router/types/**/*",
    "app/**/*",
    "app/**/.server/**/*",
    "app/**/.client/**/*",
    "server/**/*",
    "domain/**/*",
    "tests/integration/activity-loader.test.ts",
    "tests/integration/admin-loader.test.ts",
    "tests/integration/layout-loader.test.ts",
    "tests/integration/my-groups.test.ts",
    "tests/integration/admin-db.test.ts",
    "tests/integration/fx-rate-loader.test.ts",
    "tests/integration/db.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "strict": true,
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "types": ["vite/client", "node"],
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "rootDirs": [".", "./.react-router/types"],
    "paths": {
      "~/*": ["./app/*"],
      "@domain/*": ["./domain/*"],
      "@server/*": ["./server/*"]
    },
    "esModuleInterop": true,
    "resolveJsonModule": true
  }
}
