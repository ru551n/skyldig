{
  "name": "skyldig",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "dev": "NODE_ENV=development node --conditions development server.js",
    "dev:db": "tsx scripts/dev-db.ts",
    "build:wordlist": "tsx scripts/build-wordlist.ts",
    "build": "react-router build",
    "start": "node server.js",
    "typecheck": "react-router typegen && tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx server/db/migrate.ts",
    "cleanup": "tsx server/modules/expiration/cli.ts",
    "verify": "pnpm lint && pnpm typecheck && pnpm test:unit && pnpm test:integration"
  },
  "dependencies": {
    "@fontsource-variable/familjen-grotesk": "^5.3.0",
    "@react-router/express": "^8",
    "@react-router/node": "^8",
    "compression": "^1.8.1",
    "drizzle-orm": "0.45.2",
    "express": "^5.2.1",
    "helmet": "^8",
    "isbot": "^5.1.36",
    "motion": "^13",
    "pg": "^8.13.1",
    "pino": "^10",
    "pino-http": "^11",
    "radix-ui": "^1",
    "react": "^19",
    "react-dom": "^19",
    "react-router": "^8",
    "tailwindcss": "^4",
    "zod": "^4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9",
    "@playwright/test": "^1.63",
    "@react-router/dev": "^8",
    "@tailwindcss/vite": "^4",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/express-serve-static-core": "^5.1.1",
    "@types/node": "^22",
    "@types/pg": "^8.11.10",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4",
    "drizzle-kit": "0.31.6",
    "embedded-postgres": "17.10.0-beta.17",
    "eslint": "^10",
    "eslint-config-prettier": "^9",
    "eslint-plugin-react-hooks": "^7",
    "pino-pretty": "^13",
    "prettier": "^3",
    "prettier-plugin-tailwindcss": "^0.6",
    "qrcode": "^1.5.4",
    "tsx": "^4",
    "typescript": "5.9.3",
    "typescript-eslint": "^8",
    "vite": "^8",
    "vitest": "^4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@embedded-postgres/linux-x64",
      "esbuild"
    ]
  }
}
