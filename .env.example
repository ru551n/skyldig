PORT=3000
DATABASE_URL=postgres://skyldig:skyldig@localhost:5432/skyldig
# generate with: openssl rand -base64 48
ACCESS_KEY_PEPPER=
PUBLIC_ORIGIN=http://localhost:3000
# number of reverse proxies in front of the app (1 for a single nginx/Caddy/Traefik), or a
# comma-separated list of loopback/linklocal/uniquelocal/IP/CIDR peers; empty = none trusted
TRUST_PROXY=
# defaults to true when NODE_ENV=production, false otherwise; set explicitly if that's wrong
# for your setup (e.g. serving production over plain http behind a proxy that terminates TLS)
COOKIE_SECURE=
# minutes an admin elevation stays effective before the admin key must be re-entered (1-1440); defaults to 30
ADMIN_ELEVATION_TTL_MINUTES=
LOG_LEVEL=info
NODE_ENV=development
# set to "false" to disable outbound exchange-rate lookups (Frankfurter) used to prefill the rate field; defaults to true
FX_RATE_LOOKUP_ENABLED=

# used by compose.yaml to build the db service and DATABASE_URL
POSTGRES_PASSWORD=skyldig
