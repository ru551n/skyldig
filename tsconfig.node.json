{
  "extends": "./tsconfig.json",
  "include": [
    "server.js",
    "vite.config.ts",
    "drizzle.config.ts",
    "domain/**/*",
    "scripts/**/*",
    "tests/**/*",
    "server/**/*"
  ],
  "exclude": ["server/http/**/*", "server/app.ts"],
  "compilerOptions": {
    "composite": true,
    "strict": true,
    "types": ["node"],
    "lib": ["ES2022"],
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "paths": {
      "~/*": ["./app/*"],
      "@domain/*": ["./domain/*"],
      "@server/*": ["./server/*"]
    }
  }
}
