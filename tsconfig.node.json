{
  "extends": "./tsconfig.json",
  "include": [
    "server.js",
    "vite.config.ts",
    "drizzle.config.ts",
    "domain/**/*",
    "scripts/**/*.ts",
    "tests/**/*",
    "server/**/*"
  ],
  "exclude": [
    "server/http/**/*",
    "server/app.ts",
    "server/modules/i18n/**/*",
    "tests/integration/activity-loader.test.ts",
    "tests/integration/admin-loader.test.ts",
    "tests/integration/fx-rate-loader.test.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "strict": true,
    "types": ["node"],
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "paths": {
      "~/*": ["./app/*"],
      "@domain/*": ["./domain/*"],
      "@server/*": ["./server/*"]
    }
  }
}
